# =============================================================================
# HeartNote Server Environment Configuration
# =============================================================================

# Server
PORT=80
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:80,http://localhost

# Supabase
# JWT verification uses RS256 + JWKS (auto-fetched from SUPABASE_URL).
# No shared JWT secret is needed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Business Logic Limits
MAX_ACTIVE_PAGES=3
PAGE_EXPIRY_HOURS=1

# Database (Direct connection for SQLAlchemy if needed)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
