# ===========================================
# HeartNote Environment Configuration
# ===========================================
# Copy this file to .env and update the values

# -----------------
# Database (PostgreSQL)
# -----------------
POSTGRES_USER=heartnote
POSTGRES_PASSWORD=heartnote_secret
POSTGRES_DB=heartnote
DB_PORT=5432

# -----------------
# Backend (FastAPI)
# -----------------
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true
SERVER_PORT=8000
CORS_ORIGINS=*
API_V1_PREFIX=/api/v1

# JWT Configuration
# NOTE: Supabase auth now uses RS256 + JWKS (keys auto-fetched from SUPABASE_URL).
# The JWT_SECRET_KEY below is only for non-Supabase internal flows.
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------
# Frontend (Next.js)
# -----------------
CLIENT_PORT=3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:80
NEXT_PUBLIC_APP_NAME=HeartNote

# -----------------
# Supabase (Optional - for production)
# -----------------
# SUPABASE_URL=your-supabase-url
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
