# ===========================================
# HeartNote – Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All others are server-only (used in Server Actions / API routes).

# -----------------
# Supabase (Required)
# -----------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only – needed by admin.ts for service-role operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------
# Site URL (Required)
# -----------------
# Used for password-reset redirect URLs, SEO meta, and share links.
NEXT_PUBLIC_SITE_URL=https://heartnote.co.il

# -----------------
# Resend – Transactional Email (Required)
# -----------------
RESEND_KEY=re_your-resend-api-key

# Sender email (optional – defaults to noreply@heartnote.co.il)
# RESEND_FROM_EMAIL=HeartNote <noreply@heartnote.co.il>

# Recipient email for the contact form
MAIL_HEART_NOTE=info@heartnote.co.il

# -----------------
# Analytics (Optional)
# -----------------
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
