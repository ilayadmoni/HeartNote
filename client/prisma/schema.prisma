generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth (NextAuth / Auth.js v5 + Prisma Adapter) ──────────────────────────

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(6)
  image         String?
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  accounts  Account[]
  auditLogs AuditLog[]
  profile   Profile?

  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "idx_accounts_user_id")
  @@map("accounts")
}

/// Hand-rolled email-verification / password-reset tokens for the Credentials
/// provider (NextAuth's own VerificationToken model is only auto-used by the
/// Email/passwordless provider). Tokens are stored hashed.
model VerificationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  tokenHash  String    @unique(map: "idx_verification_tokens_hash") @map("token_hash")
  type       String // 'email_verification' | 'password_reset' — see CHECK constraint in db/schema.sql
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([identifier, type, consumedAt], map: "idx_verification_tokens_lookup")
  @@map("verification_tokens")
}

// ── Application ─────────────────────────────────────────────────────────

model Profile {
  id                     String    @id @db.Uuid
  email                  String?
  firstName              String?   @map("first_name")
  lastName               String?   @map("last_name")
  dateOfBirth            DateTime? @map("date_of_birth") @db.Date
  avatarUrl              String?   @map("avatar_url")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime? @map("updated_at") @db.Timestamptz(6)
  subscriptionTier       String    @default("free") @map("subscription_tier") // 'free' | 'lite' | 'premium'
  creationsCountFree     Int       @default(0) @map("creations_count_free")
  creationsCountPro      Int       @default(0) @map("creations_count_pro")
  additionalCreationFree Int       @default(0) @map("additional_creation_free")
  additionalCreationPro  Int       @default(0) @map("additional_creation_pro")
  premiumStart           DateTime? @map("premium_start") @db.Timestamp(6)
  premiumExpiry          DateTime? @map("premium_expiry") @db.Timestamp(6)
  resetAttempts          Int       @default(0) @map("reset_attempts")
  isBlocked              Boolean   @default(false) @map("is_blocked")
  locale                 String    @default("he") // 'he' | 'en'

  user      User       @relation(fields: [id], references: [id], onDelete: Cascade)
  creations Creation[]

  @@index([email], map: "idx_profiles_email")
  @@index([firstName], map: "idx_profiles_first_name")
  @@index([subscriptionTier], map: "idx_profiles_subscription")
  @@map("profiles")
}

model Template {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String     @unique
  name             String
  category         String[]
  tags             String?
  isPremium        Boolean    @default(false) @map("is_premium")
  configSchema     Json?      @map("config_schema")
  isActive         Boolean    @default(true) @map("is_active")
  expirationPolicy Json?      @map("expiration_policy")
  uses             Int        @default(0)
  creations        Creation[]

  @@index([uses], map: "idx_templates_uses")
  @@map("templates")
}

model Creation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  templateId       String    @map("template_id") @db.Uuid
  metadata         Json?
  isPaid           Boolean?  @map("is_paid")
  expiresAt        DateTime? @map("expires_at") @db.Timestamp(6)
  isDeleted        Boolean   @default(false) @map("is_deleted")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  verificationCode String    @map("verification_code") // 4-digit — see CHECK constraint in db/schema.sql

  profile  Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_creations_user_id")
  @@index([templateId], map: "idx_creations_template_id")
  @@index([expiresAt], map: "idx_creations_expires_at")
  @@map("creations")
}

model SubscriptionPolicy {
  tierCode      String @id @map("tier_code")
  creationLimit Int?   @map("creation_limit")
  defaultExpiry Int?   @map("default_expiry")

  @@map("subscription_policies")
}

model BannedUser {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email    String   @unique
  reason   String   @default("self_deletion")
  bannedAt DateTime @default(now()) @map("banned_at") @db.Timestamptz(6)

  @@index([email], map: "idx_banned_users_email")
  @@map("banned_users")
}

model PasswordResetAttempt {
  id        BigInt   @id @default(autoincrement())
  email     String
  ipAddress String?  @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt(sort: Desc)], map: "idx_pra_email_created")
  @@map("password_reset_attempts")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type") // see CHECK constraint in db/schema.sql
  metadata  Json     @default("{}")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "idx_audit_logs_user_created")
  @@index([eventType, createdAt(sort: Desc)], map: "idx_audit_logs_event_created")
  @@map("audit_logs")
}

/// Guest drafts saved before OAuth login. Write-mostly: reads only ever
/// happen server-side via claimGuestDraft() using an elevated DB connection,
/// mirroring the write-only RLS policy this table had under Supabase.
model Draft {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metadata  Json      @default("{}")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("drafts")
}
