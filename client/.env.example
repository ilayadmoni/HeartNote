# ─────────────────────────────────────────────────────────────
# HeartNote — Client Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# Local Postgres (docker-compose) — used to build DATABASE_URL below
POSTGRES_USER=heartnote
POSTGRES_PASSWORD=change-me
POSTGRES_DB=heartnote_dev
POSTGRES_PORT=5432

# pgAdmin (optional, docker compose --profile tools up -d)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# Database (server-only) — Prisma
DATABASE_URL=postgresql://heartnote:change-me@localhost:5432/heartnote_dev

# NextAuth (Auth.js v5)
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth — create at console.cloud.google.com (Credentials > OAuth
# client ID > Web application), authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Resend email service (server-only)
RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_HEART_NOTE=your-email@example.com

# Site URL (used for redirects, OG meta, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager (optional — leave empty to disable)
NEXT_PUBLIC_GTM_ID=

# AI text-assist (editor "כתיבה עם AI" button) — any OpenAI-compatible
# chat-completions endpoint. Leave unset to disable the feature entirely.
#
# Option A — OpenAI:
#   AI_API_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#   AI_API_KEY=sk-...
#
# Option B — OpenRouter (proxies OpenAI + many other models, one key):
#   AI_API_URL=https://openrouter.ai/api/v1
#   AI_MODEL=openai/gpt-4o-mini
#   AI_API_KEY=sk-or-...
AI_API_URL=
AI_MODEL=
AI_API_KEY=

# LAN IP for mobile dev testing (dev only)
LAN_IP=
