# ─────────────────────────────────────────────────────────────
# HeartNote — Client Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server-only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (server-only)
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# Resend email service (server-only)
RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_HEART_NOTE=your-email@example.com

# Site URL (used for redirects, OG meta, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager (optional — leave empty to disable)
NEXT_PUBLIC_GTM_ID=

# LAN IP for mobile dev testing (dev only)
LAN_IP=
