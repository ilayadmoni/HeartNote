# =============================================================================
# HeartNote Docker Ignore File
# =============================================================================
# Prevents sensitive files and unnecessary data from being included in
# Docker build context.

# Git
.git
.gitignore
.gitattributes

# Environment files (CRITICAL - never include in build context)
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example
server/.env
server/.env.*
!server/.env.example

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# Next.js
.next
out
dist
build

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv
ENV
env
*.egg
*.egg-info
.eggs
.pytest_cache
.mypy_cache
.coverage
htmlcov

# Build artifacts
*.log
*.tmp
coverage
.nyc_output

# OS files
.DS_Store
Thumbs.db

# Documentation (not needed in production)
*.md
!README.md
docs

# Test files
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
tests
test

# Development tools
.turbo
.husky
.eslintcache

# Session/backup files
*.bak
*.backup

# Secrets (extra safety)
*.key
*.pem
*.p8
secrets/
credentials.json
auth-tokens.json
